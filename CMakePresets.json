{
  "version": 8,

  "configurePresets": [
    {
      "name": "mingw-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "c:/Installed_Added/Development/mingw64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "c:/Installed_Added/Development/mingw64/bin/g++.exe",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/install"
      }
    },
    {
      "name": "mingw-debug",
      "displayName": "MinGW Debug",
      "inherits": "mingw-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "mingw-release",
      "displayName": "MinGW Release",
      "inherits": "mingw-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "mingw-debug"
    },
    {
      "name": "release",
      "configurePreset": "mingw-release"
    }
  ]
}
